# You don't need to edit this file by hand: open http://localhost:3000/setup and paste keys there.
# The setup page writes .env.local (loaded after .env, so its values win). Keys typed there never leave this computer.
# Saving from the page only works on localhost in development (or with ALLOW_SETUP_WRITES=1).

# Plaid: dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
# sandbox (fake banks, free) | production (real banks, billed per linked item)
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Supabase: supabase.com/dashboard -> project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Lets broke create and update its own tables on start. Supabase -> Connect (top bar) -> Session pooler -> URI,
# with [YOUR-PASSWORD] replaced by your database password.
SUPABASE_DB_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# AI for Ask broke uses the AI apps you're already signed in to on this computer, so it runs on your
# plan's allowance (no API keys, no API bill): Claude Code (`claude`), Codex (`codex login`) or Gemini CLI (`gemini`).
# Setup (gear icon) shows which are ready. Nothing to put here for them.
# Local model (Ollama or LM Studio). Ollama: install, then `ollama pull <model>`.
# LM Studio's server is http://localhost:1234/v1. LOCAL_LLM_MODEL empty = first installed model.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=

# Set to 1 on a hosted server (Vercel sets this up by itself): AI is each user's OpenRouter account, or their own AI app through the helper on Connect your AI.
# BROKE_HOSTED=1

# Dev only: "Skip login" signs in as this account (ignored in production)
DEV_LOGIN_EMAIL=
